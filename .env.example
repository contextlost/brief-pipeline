# Copy to .env and fill in your own values. .env is gitignored -- never commit it.
# RSS needs no keys; this file reserves the pattern for later steps.

# Full-article research API key (optional, reserved):
# NEWS_API_KEY=

# LLM writer (optional). Without this, the extractive narrator is used.
# Works with any OpenAI-compatible chat API.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
